<!-- ═══════════════════════════════════════════
     JAVASCRIPT
     ═══════════════════════════════════════════ -->
<script>
var nbRegistry  = <?= json_encode($block_registry, JSON_UNESCAPED_UNICODE) ?>;
var nbSaveUrl   = <?= json_encode($save_url,        JSON_UNESCAPED_UNICODE) ?>;
var nbCanvasUrl = <?= json_encode($canvas_url,      JSON_UNESCAPED_UNICODE) ?>;
var nbCsrf      = <?= json_encode(cmsForm::getCSRFToken(), JSON_UNESCAPED_UNICODE) ?>;
var nbState = {
    blocks:   <?= json_encode($page['blocks'] ?? [], JSON_UNESCAPED_UNICODE) ?>,
    selected: null,
    dirty:    false
};

var nbCatLabels = {
    'hero'   : 'Обложки',
    'content': 'Контент',
    'grid'   : 'Сетки',
    'cta'    : 'Призыв',
    'media'  : 'Медиа',
};
var nbBlockIcons = {
    'hero'        : 'fa-image',
    'features'    : 'fa-th',
    'text_section': 'fa-align-left',
    'cta'         : 'fa-bullhorn',
};

/* ── Wireframe HTML per type ═══════════════════════════ */
var nbWireframes = {
    'hero': '<div class="nb-wf" style="padding:0 6px"><div class="nb-wf-acc"></div><div class="nb-wf-h" style="width:85%"></div><div class="nb-wf-t" style="width:70%"></div><div class="nb-wf-t" style="width:55%"></div><div class="nb-wf-row" style="margin-top:4px"><div class="nb-wf-btn"></div><div class="nb-wf-btn-o"></div></div></div>',
    'hero_split': '<div class="nb-wf"><div class="nb-wf-row" style="align-items:flex-start;gap:8px"><div class="nb-wf" style="flex:1;padding:0"><div class="nb-wf-h" style="width:90%"></div><div class="nb-wf-t"></div><div class="nb-wf-btn" style="margin-top:4px"></div></div><div class="nb-wf-img"></div></div></div>',
    'features': '<div class="nb-wf"><div class="nb-wf-h" style="width:55%;margin:0 auto"></div><div class="nb-wf-g3" style="margin-top:4px"><div class="nb-wf-card"><div class="nb-wf-icon"></div><div class="nb-wf-t"></div><div class="nb-wf-t" style="width:80%"></div></div><div class="nb-wf-card"><div class="nb-wf-icon"></div><div class="nb-wf-t"></div><div class="nb-wf-t" style="width:80%"></div></div><div class="nb-wf-card"><div class="nb-wf-icon"></div><div class="nb-wf-t"></div><div class="nb-wf-t" style="width:80%"></div></div></div></div>',
    'text_section': '<div class="nb-wf"><div class="nb-wf-h" style="width:50%;margin:0 auto"></div><div class="nb-wf-t"></div><div class="nb-wf-t" style="width:90%"></div><div class="nb-wf-t" style="width:75%"></div></div>',
    'cta': '<div class="nb-wf"><div class="nb-wf-strip"><div class="nb-wf-strip-inner"><div class="nb-wf-strip-h"></div><div class="nb-wf-strip-h" style="width:40%"></div></div><div class="nb-wf-strip-btn"></div></div></div>',
    '__default': '<div class="nb-wf"><div class="nb-wf-h" style="width:70%"></div><div class="nb-wf-t"></div><div class="nb-wf-t" style="width:80%"></div></div>'
};

function getWireframe(type) {
    return '<div class="nb-wire-scene">' + (nbWireframes[type] || nbWireframes['__default']) + '</div>';
}

/* ── Utils ═════════════════════════════════════════════ */
function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function genUid() {
    return 'b' + Date.now().toString(36) + Math.random().toString(36).slice(2,6);
}
function getSchema(type) {
    return nbRegistry[type] ? nbRegistry[type].schema : null;
}
function getBlock(uid) {
    return nbState.blocks.find(function(b){ return b.uid === uid; }) || null;
}

/* ── Block list (right panel) ══════════════════════════ */
function renderBlockList() {
    var list  = document.getElementById('nbeBlockList');
    var count = document.getElementById('nbeBlockCount');
    count.textContent = nbState.blocks.length;

    if (!nbState.blocks.length) {
        list.innerHTML = '<div class="nbe-blocks-empty">Нет блоков. Нажмите<br>«Добавить блок».</div>';
        return;
    }
    list.innerHTML = nbState.blocks.map(function(block, idx) {
        var schema = getSchema(block.type);
        var title  = schema ? schema.title : block.type;
        var icon   = nbBlockIcons[block.type] || 'fa-cube';
        var sel    = nbState.selected === block.uid;
        return '<div class="nbe-block-row' + (sel ? ' is-sel' : '') + '" data-uid="' + esc(block.uid) + '">'
            + '<div class="brow-icon"><i class="fa ' + icon + '"></i></div>'
            + '<div style="flex:1;min-width:0">'
            + '<div class="brow-name">' + esc(title) + '</div>'
            + '<div class="brow-type">' + esc(block.type) + '</div>'
            + '</div>'
            + '<div class="nbe-block-row-actions">'
            + (idx > 0 ? '<button data-up="' + esc(block.uid) + '" title="Вверх"><i class="fa fa-chevron-up"></i></button>' : '<span style="width:22px"></span>')
            + (idx < nbState.blocks.length - 1 ? '<button data-dn="' + esc(block.uid) + '" title="Вниз"><i class="fa fa-chevron-down"></i></button>' : '<span style="width:22px"></span>')
            + '<button class="del" data-rm="' + esc(block.uid) + '" title="Удалить"><i class="fa fa-trash"></i></button>'
            + '</div>'
            + '</div>';
    }).join('');

    list.querySelectorAll('.nbe-block-row').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target.closest('.nbe-block-row-actions')) return;
            selectBlock(el.dataset.uid);
        });
    });
    list.querySelectorAll('[data-up]').forEach(function(el) {
        el.addEventListener('click', function(e) { e.stopPropagation(); moveBlock(el.dataset.up, -1); });
    });
    list.querySelectorAll('[data-dn]').forEach(function(el) {
        el.addEventListener('click', function(e) { e.stopPropagation(); moveBlock(el.dataset.dn, 1); });
    });
    list.querySelectorAll('[data-rm]').forEach(function(el) {
        el.addEventListener('click', function(e) {
            e.stopPropagation();
            if (!confirm('Удалить блок?')) return;
            var uid = el.dataset.rm;
            nbState.blocks = nbState.blocks.filter(function(b){ return b.uid !== uid; });
            if (nbState.selected === uid) { nbState.selected = null; renderInspector(null); }
            renderBlockList();
            markDirty();
        });
    });
}

/* ── Inspector ═════════════════════════════════════════ */
function selectBlock(uid) {
    nbState.selected = uid;
    renderBlockList();
    renderInspector(uid);
}

function renderInspector(uid) {
    var block  = uid ? getBlock(uid) : null;
    var schema = block ? getSchema(block.type) : null;
    var wrap   = document.getElementById('nbe-inspector');

    if (!block || !schema) {
        wrap.innerHTML = '<div class="nbe-insp-empty"><i class="fa fa-mouse-pointer" style="font-size:1.4rem;opacity:.4"></i><div>Выберите блок, чтобы<br>редактировать поля</div></div>';
        return;
    }
    var fields = schema.fields || [];
    var html = '<div class="nbe-insp-title"><i class="fa ' + (nbBlockIcons[block.type] || 'fa-cube') + '"></i>' + esc(schema.title) + '</div>';

    fields.forEach(function(field) {
        var val = block.props[field.key] !== undefined ? block.props[field.key] : (field.default || '');
        html += '<div class="nbe-field"><label>' + esc(field.label) + '</label>';
        if (field.type === 'select') {
            html += '<select data-field="' + esc(field.key) + '">';
            (field.options || []).forEach(function(opt) {
                html += '<option value="' + esc(opt.value) + '"' + (opt.value === val ? ' selected' : '') + '>' + esc(opt.label) + '</option>';
            });
            html += '</select>';
        } else if (field.type === 'textarea') {
            html += '<textarea data-field="' + esc(field.key) + '" rows="3">' + esc(String(val)) + '</textarea>';
        } else if (field.type === 'color') {
            html += '<div class="nbe-color-row"><div class="nbe-color-swatch"><input type="color" data-cp="' + esc(field.key) + '" value="' + esc(String(val)) + '"></div><input type="text" data-field="' + esc(field.key) + '" value="' + esc(String(val)) + '" placeholder="#rrggbb"></div>';
        } else {
            html += '<input type="text" data-field="' + esc(field.key) + '" value="' + esc(String(val)) + '">';
        }
        html += '</div>';
    });
    wrap.innerHTML = html;

    var debTimer;
    wrap.querySelectorAll('[data-field]').forEach(function(el) {
        el.addEventListener('input', function() {
            block.props[el.dataset.field] = el.value;
            markDirty();
            clearTimeout(debTimer);
            debTimer = setTimeout(function(){ autoSavePreview(); }, 800);
        });
    });
    wrap.querySelectorAll('[data-cp]').forEach(function(picker) {
        picker.addEventListener('input', function() {
            var k = picker.dataset.cp;
            block.props[k] = picker.value;
            var txt = wrap.querySelector('[data-field="' + k + '"]');
            if (txt) txt.value = picker.value;
            markDirty();
            clearTimeout(debTimer);
            debTimer = setTimeout(function(){ autoSavePreview(); }, 600);
        });
    });
}

/* Auto-save + refresh iframe preview */
function autoSavePreview() {
    saveBlocks(function() { reloadCanvas(); });
}

/* ── ADD BLOCK ═════════════════════════════════════════ */
function addBlock(type) {
    var schema = getSchema(type);
    if (!schema) return;
    var props = {};
    (schema.fields || []).forEach(function(f) { props[f.key] = f.default || ''; });
    var block = { type: type, uid: genUid(), props: props };
    nbState.blocks.push(block);
    closeModal();
    selectBlock(block.uid);
    markDirty();
    autoSavePreview();
}

function moveBlock(uid, dir) {
    var idx = nbState.blocks.findIndex(function(b){ return b.uid === uid; });
    var ni  = idx + dir;
    if (ni < 0 || ni >= nbState.blocks.length) return;
    var tmp = nbState.blocks[idx]; nbState.blocks[idx] = nbState.blocks[ni]; nbState.blocks[ni] = tmp;
    renderBlockList();
    markDirty();
    autoSavePreview();
}

/* ── SAVE ══════════════════════════════════════════════ */
var nbSaving = false;
function markDirty() {
    nbState.dirty = true;
    var btn = document.getElementById('nbeSaveBtn');
    if (btn) btn.classList.add('dirty');
}
function saveBlocks(onDone) {
    if (nbSaving) return;
    nbSaving = true;
    var btn = document.getElementById('nbeSaveBtn');
    if (btn) { btn.classList.add('saving'); btn.classList.remove('dirty'); }
    fetch(nbSaveUrl + '?csrf_token=' + nbCsrf, {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ blocks: nbState.blocks })
    })
    .then(function(r){ return r.json(); })
    .then(function(d) {
        nbSaving = false;
        if (btn) btn.classList.remove('saving');
        if (d.ok) {
            nbState.dirty = false;
            if (btn) { btn.classList.add('saved'); setTimeout(function(){ btn.classList.remove('saved'); }, 1500); }
            if (onDone) onDone();
        } else {
            alert('Ошибка: ' + (d.error || '?'));
        }
    })
    .catch(function() {
        nbSaving = false;
        if (btn) btn.classList.remove('saving');
        alert('Ошибка соединения');
    });
}

/* ── CANVAS RELOAD ═════════════════════════════════════ */
function reloadCanvas() {
    var iframe = document.getElementById('nbe-canvas-frame');
    if (iframe) {
        iframe.src = nbCanvasUrl + '?t=' + Date.now();
    }
}

/* ── VIEWPORT ══════════════════════════════════════════ */
function setViewport(type) {
    var iframe   = document.getElementById('nbe-canvas-frame');
    var btnD     = document.getElementById('nbeVpDesktop');
    var btnM     = document.getElementById('nbeVpMobile');
    if (type === 'mobile') {
        iframe.classList.add('mobile');
        btnM.classList.add('active'); btnD.classList.remove('active');
    } else {
        iframe.classList.remove('mobile');
        btnD.classList.add('active'); btnM.classList.remove('active');
    }
}

/* ── MODAL ═════════════════════════════════════════════ */
var nbModalActiveCat = '__all';

function openModal() {
    var overlay = document.getElementById('nbe-modal-overlay');
    overlay.classList.add('open');
    document.getElementById('nbe-modal-search').value = '';
    renderModalCats('__all');
    renderModalBlocks('__all', '');
    document.getElementById('nbe-modal-search').focus();
}
function closeModal() {
    document.getElementById('nbe-modal-overlay').classList.remove('open');
}

function renderModalCats(activeCat) {
    nbModalActiveCat = activeCat;
    var cats = {'__all': 'Все блоки'};
    var catCounts = {'__all': 0};
    Object.keys(nbRegistry).forEach(function(type) {
        var c = nbRegistry[type].category || 'content';
        if (!cats[c]) { cats[c] = nbCatLabels[c] || c; catCounts[c] = 0; }
        catCounts[c]++;
        catCounts['__all']++;
    });
    var html = '';
    Object.keys(cats).forEach(function(k) {
        html += '<div class="nbe-cat-item' + (k === activeCat ? ' active' : '') + '" data-cat="' + esc(k) + '">'
            + esc(cats[k])
            + '<span class="count">' + (catCounts[k] || 0) + '</span>'
            + '</div>';
    });
    var catsEl = document.getElementById('nbe-modal-cats');
    catsEl.innerHTML = html;
    catsEl.querySelectorAll('.nbe-cat-item').forEach(function(el) {
        el.addEventListener('click', function() {
            renderModalCats(el.dataset.cat);
            renderModalBlocks(el.dataset.cat, document.getElementById('nbe-modal-search').value);
        });
    });
}

function renderModalBlocks(cat, search) {
    var container = document.getElementById('nbe-modal-blocks');
    var html = '';
    Object.keys(nbRegistry).forEach(function(type) {
        var info = nbRegistry[type];
        if (cat !== '__all' && (info.category || 'content') !== cat) return;
        if (search && info.title.toLowerCase().indexOf(search.toLowerCase()) === -1 && type.indexOf(search.toLowerCase()) === -1) return;
        var thumb = getWireframe(type);
        html += '<div class="nbe-lib-card" data-add="' + esc(type) + '">'
            + '<div class="nbe-lib-card__thumb">' + thumb + '</div>'
            + '<div class="nbe-lib-card__info">'
            + '<div class="nbe-lib-card__name">' + esc(info.title) + '</div>'
            + '<div class="nbe-lib-card__desc">' + esc(nbCatLabels[info.category] || info.category) + '</div>'
            + '</div></div>';
    });
    if (!html) {
        html = '<div style="padding:2rem;color:#94a3b8;font-size:.85rem;text-align:center;grid-column:1/-1">Ничего не найдено</div>';
    }
    container.innerHTML = html;
    container.querySelectorAll('[data-add]').forEach(function(el) {
        el.addEventListener('click', function() { addBlock(el.dataset.add); });
    });
}

function filterModalBlocks(val) {
    renderModalBlocks(nbModalActiveCat, val);
}

/* ── Keyboard shortcuts ════════════════════════════════ */
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
    if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveBlocks(function(){ reloadCanvas(); }); }
});

window.addEventListener('beforeunload', function(e) {
    if (nbState.dirty) { e.preventDefault(); e.returnValue = ''; }
});

/* ── INIT ══════════════════════════════════════════════ */
renderBlockList();
</script>
